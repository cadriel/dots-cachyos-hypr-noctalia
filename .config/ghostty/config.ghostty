background-opacity = 0.95
background-blur = true
window-padding-x = 14
window-padding-y = 14
window-padding-balance = true

# Cursor trail (custom-shader requires a block cursor to render; shell
# integration otherwise switches to a bar cursor at the prompt, which would
# silently disable the effect most of the time)
cursor-style = block
shell-integration-features = no-cursor, sudo
# shell-integration-features = no-cursor, sudo, ssh-env, ssh-terminfo
custom-shader = shaders/cursor_tail.glsl
theme = noctalia

#confirm-close-surface = always  # disabled by ghostty-config: back to the default
